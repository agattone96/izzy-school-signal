{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agattone96.github.io/izzy-school-signal/schemas/calendar-cache-receipt.schema.json",
  "title": "Izzy School Signal Calendar Cache Receipt",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion", "validation", "installedAt", "schoolYear", "calendarRevision",
    "eventCount", "sourceUrl", "generatedAt", "generatorVersion"
  ],
  "properties": {
    "schemaVersion": { "const": 1 },
    "validation": { "const": "valid" },
    "installedAt": { "type": "string", "format": "date-time" },
    "schoolYear": { "type": "string", "pattern": "^20[0-9]{2}-20[0-9]{2}$" },
    "calendarRevision": { "type": "integer", "minimum": 1 },
    "eventCount": { "type": "integer", "minimum": 8 },
    "sourceUrl": { "type": "string", "format": "uri", "pattern": "^https://" },
    "generatedAt": { "type": "string", "format": "date-time" },
    "generatorVersion": { "type": "string", "minLength": 1 }
  }
}
