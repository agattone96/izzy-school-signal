{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agattone96.github.io/izzy-school-signal/schemas/public-calendar-status.schema.json",
  "title": "Izzy School Signal Public Calendar Status",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion", "status", "schoolYear", "generatedAt", "eventCount",
    "firstSchoolDay", "lastSchoolDay", "sourceUrl", "calendarSha256"
  ],
  "properties": {
    "schemaVersion": { "const": 1 },
    "status": { "const": "ready" },
    "schoolYear": { "type": "string", "pattern": "^20[0-9]{2}-20[0-9]{2}$" },
    "generatedAt": { "type": "string", "format": "date-time" },
    "eventCount": { "type": "integer", "minimum": 8 },
    "firstSchoolDay": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$" },
    "lastSchoolDay": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$" },
    "sourceUrl": { "type": "string", "pattern": "^https://www\\.hillsboroughschools\\.org/" },
    "calendarSha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
  }
}
